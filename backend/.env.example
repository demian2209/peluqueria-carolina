PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Supabase - Obtener desde: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Fase 8: Autenticación Admin
# Email del administrador del sistema (debe existir en Supabase Auth)
ADMIN_EMAIL=admin@peluqueriacarolina.com
# Solo para modo mock/dev local (nunca usar contraseñas débiles ni habilitar en producción)
ADMIN_MOCK_PASSWORD=reemplazar_por_password_seguro_en_dev

# Seguridad Criptográfica y Tokens Stateless (HMAC-SHA256)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESERVA_TOKEN_SECRET=reemplazar_por_secreto_aleatorio_de_64_caracteres_hex
INTERNAL_API_KEY=reemplazar_por_api_key_interna_n8n

# Automatización n8n - Router Central de Eventos
N8N_WEBHOOK_URL=http://localhost:5678/webhook/pc06-webhook-router

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=1327472783790822
WHATSAPP_ACCESS_TOKEN=tu_access_token_aqui
WHATSAPP_WABA_ID=2910421449331778
WHATSAPP_VERIFY_TOKEN=reemplazar_por_verify_token_meta
WHATSAPP_APP_SECRET=reemplazar_por_app_secret_meta

# Google Gemini API (PC07 Asistente) - obtener en https://aistudio.google.com/apikey
GEMINI_API_KEY= 
